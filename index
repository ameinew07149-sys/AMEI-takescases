<title>AMEI 阿梅 | 標案企劃撰寫・網站製作・活動攝影</title>
<meta name="description" content="AMEI 阿梅，六年標案企劃經驗：寫過 50 場以上標案、執行過 100 場以上活動、地方機關服務 2 年，持採購專業人員基礎訓練及格證書。政府標案與社區發展企劃撰寫，網站、互動遊戲與 app 製作，懂核銷的活動攝影。">
<meta name="keywords" content="標案企劃, 服務建議書, 企劃書撰寫, 社區發展協會, 補助案, 活動攝影, 活動網站, 報名頁, 結案報告, 核銷, 高雄, 屏東, AMEI">
<meta name="author" content="AMEI">
<meta property="og:type" content="website">
<meta property="og:title" content="AMEI 阿梅 | 寫過 50 場標案的人，幫你寫這一場">
<meta property="og:description" content="標案企劃、活動網站、互動遊戲與活動攝影——一本企劃書從調查寫到結案，中間不用換人。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --pine:#12343B; --pine-2:#1B4A50; --paper:#1a1a1a; --sheet:#1d1d1d;
  --ink:#f0f0f0; --muted:#b0b0b0; --green:#c2a25c; --green-soft:#3a3427;
  --red:#9E2A2B; --marker:#c2a25c; --kraft:#c2a25c; --kraft-d:#7d6630;
  --c-staff:#4F6D8A; --c-act:#5E7D5A; --c-pr:#A8793A; --c-admin:#7A5C86;
  --kai:'Noto Serif TC',serif; --sans:'Noto Sans TC',system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
/* ===== 按鈕與表單基礎 ===== */
.btn{font:700 1rem var(--serif,serif);letter-spacing:1px;background:var(--accent);color:#1a1a1a;border:0;padding:.85rem 1.7rem;cursor:pointer;border-radius:4px;transition:.3s}
.btn:hover{background:var(--accent-hover);transform:translateY(-2px);box-shadow:0 8px 18px rgba(194,162,92,.25)}
.req{display:grid;gap:.9rem}
.req label{font-weight:500;font-size:.92rem;display:grid;gap:.25rem}
.req .btn{justify-self:start}
.form-msg{margin:0;min-height:1.5em;font-weight:500;font-size:.95rem}
/* ===== 頁面：暗色金調 ===== */
:root{
  --bg:#1a1a1a; --bg2:#262626; --text:#f0f0f0; --text-light:#b0b0b0;
  --accent:#c2a25c; --accent-hover:#d4b472; --radius:4px;
  --shadow:0 10px 30px rgba(0,0,0,.7); --border:rgba(194,162,92,.3);
  --serif:'Noto Serif TC',serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
section[id]{scroll-margin-top:4.5rem}
body{margin:0;font-family:'Noto Sans TC','Microsoft JhengHei',sans-serif;color:var(--text);background:var(--bg);line-height:1.8;overflow-x:hidden;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E")}
a{color:inherit;text-decoration:none;transition:.3s}
h1,h2,h3{font-family:var(--serif);font-weight:700;letter-spacing:.05em;margin:0}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.container{max-width:1200px;margin:0 auto;padding:6rem 5%}
.band{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.section-title{font-size:2.3rem;margin:0 auto 3.5rem;text-align:center;color:var(--accent);position:relative;padding-bottom:1rem;width:fit-content}
.section-title::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:60px;height:3px;background:var(--accent);border-radius:2px}
.section-title::before{content:'◆';position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);color:var(--accent);font-size:.8rem;background:var(--bg);padding:0 10px;z-index:1}
.band .section-title::before{background:var(--bg2)}
.lead-c{text-align:center;color:var(--text-light);max-width:40em;margin:-2rem auto 3rem}

header{padding:1.1rem 5%;position:fixed;inset:0 0 auto 0;background:rgba(26,26,26,.95);z-index:100;backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
header nav{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}
.logo{font-family:var(--serif);font-size:1.35rem;font-weight:700;letter-spacing:1px}
.nav-links{display:flex;gap:2.5rem;list-style:none;margin:0;padding:0}
.nav-links a{color:var(--text-light);font-weight:500;letter-spacing:1px;position:relative}
.nav-links a:hover{color:var(--accent)}
.nav-links a::after{content:'';position:absolute;bottom:-5px;left:0;width:0;height:1px;background:var(--accent);transition:.3s}
.nav-links a:hover::after{width:100%}
.menu-toggle{display:none;background:none;border:0;color:var(--accent);font-size:1.6rem;cursor:pointer;line-height:1}

.hero{position:relative;padding:8.5rem 5% 5rem;border-bottom:1px solid var(--border);
  background:linear-gradient(rgba(20,18,16,.86),rgba(26,26,26,.96))}
.hero-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr minmax(0,25rem);gap:4rem;align-items:center}
.hero h1{font-size:clamp(2rem,4.6vw,3.3rem);line-height:1.3;text-shadow:0 2px 10px rgba(0,0,0,.5);margin-bottom:1.2rem}
.tagline{color:var(--accent);letter-spacing:3px;font-size:1.05rem;margin:0 0 1.2rem}
.hero-copy>p{color:rgba(255,255,255,.85);max-width:32em;margin:0 0 1.6rem}
.hstats{list-style:none;padding:1.4rem 0;margin:0 0 1.6rem;display:flex;flex-wrap:wrap;gap:1rem 2.75rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border);color:var(--text-light);font-size:.92rem}
.hstats li{display:grid}
.hstats b{font-family:var(--serif);font-size:clamp(2.4rem,5vw,3.3rem);line-height:1.1;color:var(--accent)}
.hstats i,.rec b i{font-style:normal;font-size:.42em;margin-left:.15em}
.skip{color:var(--accent);border-bottom:1px solid var(--border);padding-bottom:2px}
.skip:hover{border-color:var(--accent)}

.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);transition:all .4s ease}
.card:hover{transform:translateY(-5px);box-shadow:var(--shadow);border-color:var(--accent)}
.rec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.rec{padding:2.5rem 2rem;text-align:center}
.rec b{font-family:var(--serif);font-size:clamp(3.6rem,7vw,5rem);line-height:1;color:var(--accent);display:block}
.rec h3{font-size:1.35rem;margin:1rem 0 .8rem}
.rec p{margin:0;color:var(--text-light);font-size:.95rem;text-align:justify}
.rec-more{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:2.5rem}
.rec-more div{border-left:2px solid var(--accent);padding-left:1.2rem}
.rec-more h3{font-size:1.15rem}.rec-more p{margin:.3rem 0 0;color:var(--text-light);font-size:.93rem}

.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:2rem}
#photo-services{grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2.5rem}
@media (min-width:769px){#services .services-grid:not(#photo-services){grid-template-columns:repeat(2,1fr)}}
.service-card{background:var(--bg2);padding:2rem;display:flex;flex-direction:column}
.service-card:hover{background:var(--bg)}
.service-card svg{width:2.6rem;height:2.6rem;color:var(--accent);margin-bottom:1.2rem}
.service-subtitle{font-size:.8rem;font-weight:500;color:var(--accent);letter-spacing:2px;margin-bottom:.5rem}
.service-subtitle::before{content:'— '}
.service-title{font-size:1.55rem;margin-bottom:.8rem;line-height:1.3}
.service-desc{font-size:.95rem;color:var(--text-light);margin:0 0 1.2rem;flex:1;text-align:justify}
.detail-item{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid #333;padding:.75rem 0;font-size:.9rem;color:var(--text-light)}
.detail-item span:first-child{color:var(--accent);opacity:.85;white-space:nowrap}
.detail-item span:last-child{text-align:right}
.detail-item:last-of-type{border-bottom:none}
.service-price{font-family:var(--serif);font-size:1.3rem;color:var(--accent);margin-top:1.3rem;font-weight:700;text-align:right}
.btn-lively{display:block;text-align:center;margin-top:1.4rem;color:var(--accent);padding:12px 0;border-radius:var(--radius);font-weight:500;border:1px solid var(--accent);letter-spacing:1px;transition:.4s ease}
.btn-lively:hover{background:var(--accent);color:var(--bg);transform:translateY(-2px);box-shadow:0 5px 15px rgba(194,162,92,.2)}
.feature{border-color:var(--accent);background:linear-gradient(160deg,rgba(194,162,92,.14),rgba(26,26,26,.8) 55%)}

.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.project-card{display:block;overflow:hidden}
.project-card svg{display:block;width:100%;height:auto;filter:grayscale(.3);transition:filter .6s,transform .8s}
.project-card:hover svg{filter:none;transform:scale(1.05)}
.card-image-wrapper{overflow:hidden;background:#111}
.card-info{padding:1.5rem}
.card-meta{font-size:.85rem;color:var(--accent);font-weight:500;letter-spacing:1px;display:block;margin-bottom:.5rem}
.card-title{font-size:1.4rem;margin-bottom:.6rem}
.card-desc{font-size:.95rem;color:var(--text-light);margin:0}

.flow{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;counter-reset:f;position:relative}
.flow::before{content:'';position:absolute;top:1.5rem;left:12%;right:12%;border-top:1px solid var(--border)}
.flow li{counter-increment:f;text-align:center;position:relative}
.flow li::before{content:counter(f);display:grid;place-items:center;width:3rem;height:3rem;margin:0 auto 1.1rem;border-radius:50%;border:1px solid var(--accent);background:var(--bg);color:var(--accent);font-family:var(--serif);font-size:1.3rem;position:relative}
.flow h3{font-size:1.15rem;margin-bottom:.4rem}
.flow p{margin:0;color:var(--text-light);font-size:.93rem}

.contact-layout{display:grid;grid-template-columns:1fr 1.5fr;gap:4rem;background:var(--bg2);padding:4rem;border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);position:relative;overflow:hidden}
.contact-layout::after{content:'';position:absolute;right:-100px;bottom:-100px;width:300px;height:300px;background:radial-gradient(circle,var(--accent) 0%,transparent 70%);opacity:.1;pointer-events:none}
.contact-info h3{font-size:2.1rem;color:var(--accent);margin-bottom:1.5rem}
.contact-info p{color:var(--text-light);margin:0 0 1rem}
.contact-mail{margin-top:2rem;color:var(--text)}
.contact-mail a{color:var(--accent);border-bottom:1px solid var(--border)}
.contact-mail a:hover{border-color:var(--accent)}
.privacy-note{margin:0;font-size:.8rem;color:var(--text-light);line-height:1.6}
.hp{position:absolute!important;left:-9999px;width:1px;height:1px;overflow:hidden}
.ts-box{min-height:0}
/* 聯絡表單（暗色） */
#contact .req{gap:1.3rem;position:relative;z-index:1}
#contact .req label{color:var(--text-light);font-weight:500;gap:8px}
#contact .req input,#contact .req textarea,#contact .req select{padding:15px;border:1px solid #444;background:rgba(0,0,0,.2);border-radius:var(--radius);color:var(--text);font:inherit;width:100%;outline:none;transition:.3s}
#contact .req input:focus,#contact .req textarea:focus,#contact .req select:focus{border-color:var(--accent);background:rgba(0,0,0,.4);box-shadow:0 0 10px rgba(194,162,92,.1);outline:none}
#contact .req ::placeholder{color:#666}
#contact .req option{background:var(--bg2)}
#contact .req .btn{background:var(--accent);color:var(--bg);border-radius:var(--radius);padding:15px 50px;font:700 1.1rem var(--serif);letter-spacing:1px;box-shadow:none}
#contact .req .btn:hover{background:var(--accent-hover);transform:translateY(-2px);box-shadow:0 10px 20px rgba(194,162,92,.3);filter:none}
#contact .form-msg.ok{color:var(--accent)} #contact .form-msg.err{color:#e2736e}

footer{background:#111;color:var(--text-light);text-align:center;padding:3.5rem 5% 4.5rem;font-size:.9rem;border-top:1px solid var(--border)}


@media (max-width:900px){
  .hero-grid{grid-template-columns:1fr;gap:2.5rem}
  .rec-grid,.project-grid{grid-template-columns:1fr}
  .rec-more{grid-template-columns:1fr}
  .flow{grid-template-columns:1fr 1fr}.flow::before{display:none}
  .contact-layout{grid-template-columns:1fr;padding:2rem;gap:2.5rem}
}
@media (max-width:768px){
  .nav-links{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;gap:1.4rem;background:var(--bg2);padding:2rem 5%;border-bottom:1px solid var(--border);box-shadow:0 10px 20px rgba(0,0,0,.5)}
  .nav-links.open{display:flex}
  .menu-toggle{display:block}
  .logo{font-size:1.15rem}
  .hero{padding:6.5rem 5% 3.5rem}
  .container{padding:4rem 5%}
  .section-title{font-size:1.9rem}
  .services-grid{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.card,.project-card svg,.btn-lively{transition:none}}


/* ===== v7：照片作品（讀 Google 試算表）與 Modal ===== */
img{-webkit-user-drag:none;user-select:none}
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.photo-card{display:flex;flex-direction:column;justify-content:flex-start;cursor:pointer;overflow:hidden;text-align:left;padding:0;color:inherit;font:inherit;width:100%}
.photo-card .card-image-wrapper{aspect-ratio:4/3}
.photo-card img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(.3);transition:transform .8s ease,filter .6s}
.photo-card:hover img{transform:scale(1.05);filter:grayscale(0)}
.photo-card .card-desc{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.grid-note{grid-column:1/-1;text-align:center;color:#888}
.sub-title{font-size:1.5rem;color:var(--accent);text-align:center;margin:4.5rem 0 2.5rem}
.service-img{height:200px;overflow:hidden;border-radius:4px;border:1px solid #333;margin-bottom:1.2rem}
.service-img img{width:100%;height:100%;object-fit:cover;filter:sepia(.4) contrast(1.1);transition:transform .6s,filter .6s}
.service-card:hover .service-img img{transform:scale(1.05);filter:none}
.modal{position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.95);backdrop-filter:blur(8px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .4s ease,visibility 0s linear .4s;overflow-y:auto}
.modal.active{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .4s ease,visibility 0s}
.modal-close{position:fixed;top:20px;right:30px;color:var(--accent);background:var(--bg2);border:1px solid var(--border);width:50px;height:50px;font-size:2rem;line-height:1;cursor:pointer;z-index:2001;border-radius:50%}
.modal-content{max-width:1000px;margin:5rem auto;background:var(--bg);padding:4rem;border-radius:4px;box-shadow:var(--shadow);border:1px solid var(--border);text-align:center}
.modal-meta{color:var(--accent);font-weight:700;letter-spacing:2px}
.modal-title{font-size:2.6rem;color:var(--accent);margin-top:.5rem}
.modal-rule{width:50px;height:2px;background:var(--accent);margin:1rem auto}
.modal-desc{color:var(--text-light);text-align:justify;margin:1.5rem 0 2.5rem}
.modal-figure{margin:0 0 40px}
.modal-figure img{width:100%;height:auto;border-radius:4px;box-shadow:0 15px 40px rgba(0,0,0,.5);border:1px solid #333;margin-bottom:15px}
.modal-caption{font-size:1rem;color:var(--text-light);font-style:italic;border-left:2px solid var(--accent);padding-left:15px;display:inline-block;text-align:left;max-width:80%}
@media (max-width:900px){.photo-grid{grid-template-columns:1fr;gap:2.5rem}.modal-content{padding:2rem;margin:4.5rem 4% 3rem}.modal-title{font-size:1.9rem}}
/* ===== v8：主視覺「改表格，網頁就更新」示範 ===== */
.hero-links{display:flex;flex-wrap:wrap;gap:.6rem 1.8rem}
.live-demo{background:var(--bg2);border:1px solid var(--accent);border-radius:6px;box-shadow:var(--shadow);padding:1.1rem;display:grid;gap:.9rem;position:relative;z-index:1}
.pane-name{display:flex;justify-content:space-between;align-items:baseline;font-size:.8rem;color:var(--text-light);margin-bottom:.35rem}
.pane-name b{font-family:var(--serif);font-size:.95rem;color:var(--accent);letter-spacing:1px}
.sheet{width:100%;border-collapse:collapse;font-size:.88rem;background:#1f1f1f}
.sheet th,.sheet td{border:1px solid #3a3a3a;padding:0}
.sheet th{width:4.8rem;font-weight:500;color:var(--text-light);background:#2b2b2b;padding:.35rem .5rem;text-align:left}
.sheet input{width:100%;font:inherit;color:var(--text);background:transparent;border:0;padding:.35rem .5rem;border-radius:0}
.sheet input:focus{outline:2px solid var(--accent);outline-offset:-2px;background:rgba(194,162,92,.08)}
.browser{border:1px solid #3a3a3a;border-radius:6px;overflow:hidden;background:#f3efe6;color:#2a2620}
.browser-bar{display:flex;align-items:center;gap:.3rem;background:#2b2b2b;padding:.35rem .55rem}
.browser-bar i{width:.5rem;height:.5rem;border-radius:50%;background:#555}
.browser-bar span{flex:1;margin-left:.4rem;background:#1f1f1f;border-radius:3px;font-size:.7rem;color:#888;padding:.05rem .5rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ev{padding:1.1rem 1.2rem 1.2rem;display:grid;gap:.35rem;line-height:1.5}
.ev-date{font-size:.8rem;color:#9E2A2B;font-weight:700;letter-spacing:1px}
.ev-title{font-family:var(--serif);font-size:1.45rem;line-height:1.3;word-break:break-word}
.ev-place{font-size:.85rem;color:#5c554a}
.ev-foot{display:flex;justify-content:space-between;align-items:center;margin-top:.45rem;padding-top:.6rem;border-top:1px solid #d9d1c1;font-size:.82rem}
.ev-foot em{font-style:normal;background:#2a2620;color:#f3efe6;padding:.25rem .8rem;border-radius:3px}
.ev [data-f]{transition:background-color .6s}
.ev .flash{background-color:rgba(194,162,92,.45)}
.demo-head{border-bottom:1px solid var(--border);padding-bottom:.8rem}
.demo-title{font-size:1.35rem;color:var(--accent);line-height:1.4}
.demo-head p{margin:.2rem 0 0;font-size:.85rem;color:var(--text-light)}
.sheet textarea{width:100%;font:inherit;color:var(--text);background:transparent;border:0;padding:.35rem .5rem;border-radius:0;resize:vertical;line-height:1.6;display:block}
.sheet textarea:focus{outline:2px solid var(--accent);outline-offset:-2px;background:rgba(194,162,92,.08)}
.flow-head{display:flex;justify-content:space-between;align-items:center;margin:.7rem 0 .35rem;font-size:.85rem;color:var(--text-light)}
.add-row{font:inherit;font-size:.8rem;color:var(--accent);background:transparent;border:1px solid var(--accent);border-radius:3px;padding:.2rem .7rem;cursor:pointer;transition:.3s}
.add-row:hover{background:var(--accent);color:#1a1a1a}
.add-row:disabled{opacity:.4;cursor:default;background:transparent;color:var(--accent)}
.flow-sheet td.t{width:4.8rem}
.flow-sheet td.x{width:2rem;text-align:center}
.flow-sheet .del{background:none;border:0;color:#888;font-size:1rem;cursor:pointer;width:100%;padding:.3rem 0;line-height:1}
.flow-sheet .del:hover{color:#e2736e}
.ev-desc{margin:.3rem 0 0;font-size:.85rem;color:#3d372e;line-height:1.7;white-space:pre-line}
.ev-flow{margin-top:.35rem;font-size:.82rem}
.ev-flow b{font-family:var(--serif);font-size:.85rem}
.ev-flow ol{list-style:none;margin:.25rem 0 0;padding:0;display:grid;gap:.15rem}
.ev-flow li{display:grid;grid-template-columns:3.4rem 1fr;gap:.5rem;border-left:2px solid #c2a25c;padding-left:.5rem}
.ev-flow li span:first-child{color:#9E2A2B;font-weight:700}
.ev-flow[hidden]{display:none}
.demo-cta{display:block;text-align:center;font-family:var(--serif);font-weight:700;font-size:1.05rem;letter-spacing:1px;color:#1a1a1a;background:var(--accent);padding:.8rem;border-radius:4px}
.demo-cta:hover{background:var(--accent-hover);transform:translateY(-2px);box-shadow:0 8px 18px rgba(194,162,92,.25)}
/* 數位作品下方的做法說明 */
