<script src="https://cdn.jsdelivr.net/npm/papaparse@5.3.0/papaparse.min.js" integrity="sha384-fU3JmTM3BACOkkqkyvCkZsp5gC4snA8QP4b7tOxoRl8duHf6pxMO0g/YlxM4izL3" crossorigin="anonymous"></script>
<script>
/* 表單收件：部署 詢問表單收件.gs 之後，把「網頁應用程式」網址貼在下面。 */
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbx7gCbkBS5lHDLaHkit7O6WJJlPTj06V2zt0fKffhvxXWhfZGwjZUyQa6H4ytGcvPwS9w/exec";

const $ = (s, r = document) => r.querySelector(s);
/* 資安：試算表來的文字一律跳脫，網址只接受 https */
const esc = v => String(v == null ? '' : v).replace(/[&<>"'`]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','`':'&#96;'}[c]));
const safeUrl = v => {
  const s = String(v || '').trim();
  /* 儲存庫裡的圖片：只接受 img/ 開頭、不含 .. 與特殊字元的相對路徑 */
  if (/^img\/[^\s"'<>\\?#]+$/.test(s) && !s.includes('..')) return encodeURI(s);
  try { const u = new URL(s); return u.protocol === 'https:' ? u.href : ''; } catch(_) { return ''; }
};
/* 信箱用程式組出，避免被爬蟲直接抓走 */
const MAIL = ['ameinew07149', 'gmail.com'].join('@');
/* 選用：Cloudflare Turnstile 人機驗證。申請後把 Site key 貼進來；留空就不啟用。 */
const TURNSTILE_SITEKEY = "";

/* ========== 表單（送到 Google Apps Script） ========== */
function mountForm(host){
  const f = $('#form-tpl').content.firstElementChild.cloneNode(true);
  const msg = $('.form-msg', f), btn = $('button[type=submit]', f), el = n => f.elements[n];
  const say = (t,cls) => { msg.textContent = t; msg.className = 'form-msg '+cls; };
  let openedAt = Date.now(), cooldownUntil = 0;
  if (TURNSTILE_SITEKEY){
    const box = $('.ts-box', f); box.className = 'ts-box cf-turnstile'; box.dataset.sitekey = TURNSTILE_SITEKEY; box.dataset.theme = 'dark';
    const s = document.createElement('script'); s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js'; s.async = true; s.defer = true; document.head.append(s);
  }
  f.addEventListener('submit', async e => {
    e.preventDefault();
    if (btn.disabled) return;
    if (Date.now() < cooldownUntil){ say('剛剛已經送出過了，請稍候一分鐘再送。','err'); return; }
    const name = el('name').value.trim(), email = el('email').value.trim(), need = el('need').value.trim(), contact = el('contact').value.trim();
    if (!name){ say('請填寫您的稱呼或單位。','err'); el('name').focus(); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)){ say('Email 格式不正確，請再確認一次。','err'); el('email').focus(); return; }
    if (!need){ say('請簡單寫下您的需求。','err'); el('need').focus(); return; }
    const token = (f.querySelector('[name="cf-turnstile-response"]') || {}).value || '';
    if (TURNSTILE_SITEKEY && !token){ say('請先完成下方的人機驗證。','err'); return; }
    const fd = new FormData();
    fd.append('name', name); fd.append('email', email); fd.append('contact', contact);
    fd.append('service', el('service').value || '未選擇'); fd.append('need', need);
    fd.append('website', el('website').value); fd.append('ts', String(openedAt));
    fd.append('source', '接案網站'); fd.append('message', need + (contact ? '\n其他聯絡方式：'+contact : '')); /* 相容舊版收件程式 */ if (token) fd.append('cf-turnstile-response', token);
    btn.disabled = true; say('傳送中…','');
    try{
      const r = await fetch(SCRIPT_URL, { method:'POST', body: fd });
      let j = null; try { j = await r.json(); } catch(_){}
      if (j && j.ok === false){ say(j.error || '傳送失敗，請稍後再試。','err'); return; }
      f.reset(); openedAt = Date.now(); cooldownUntil = Date.now() + 60000;
      say('訊息已送達，我會盡快回信給您。','ok');
    }
    catch(err){ say('傳送失敗。請檢查網路後再試一次，或直接來信 '+MAIL+'。','err'); }
    finally{ btn.disabled = false; if (window.turnstile) try { window.turnstile.reset(); } catch(_){} }
  });
  host.append(f); return f;
}
function selectService(v){ document.querySelectorAll('#contact select[name=service]').forEach(s => { s.value = v; }); }

mountForm($('#contact-form'));

/* ========== 示範：試看看活動網頁怎麼建（含報名彈窗與假後台） ========== */
(function(){
  const ev = $('.ev'); if (!ev) return;
  const fallback = { title:'活動名稱', date:'日期未定', place:'地點未定', seats:'—', desc:'' };
  const data = {};
  const flash = el => { el.classList.add('flash'); clearTimeout(el._t); el._t = setTimeout(()=>el.classList.remove('flash'), 450); };
  const render = (k, v, fl) => {
    data[k] = v.trim();
    document.querySelectorAll('[data-f="'+k+'"]').forEach(el => {
      el.textContent = data[k] || fallback[k];
      if (k === 'desc') el.hidden = !data[k];
      if (fl && ev.contains(el)) flash(el);
    });
    if (k === 'seats') updateStats();
  };

  /* ---- 報名資料（示範用，只存在記憶體） ---- */
  const regs = [
    { n:'陳美玲', p:'0912345318', c:2, at:'09/20 14:02' },
    { n:'張志明', p:'0933218456', c:1, at:'09/21 09:47' },
    { n:'黃淑芬', p:'0958773021', c:4, at:'09/22 20:15' }
  ];
  let open = true, newIdx = -1;
  const seatsNum = () => parseInt(data.seats, 10) || 0;
  const taken = () => regs.reduce((s, r) => s + r.c, 0);
  const left = () => Math.max(0, seatsNum() - taken());
  const mask = p => p.length >= 7 ? p.slice(0,4)+'-***-'+p.slice(-3) : p;
  const join = $('#ev-join');

  function updateStats(){
    const s = seatsNum(), t = taken(), l = left();
    $('#ev-left').textContent = l;
    $('#adm-count').textContent = t;
    $('#adm-left').textContent = l;
    const bar = $('#adm-bar'); bar.style.width = (s ? Math.min(100, t / s * 100) : 0) + '%';
    bar.parentElement.classList.toggle('full', s > 0 && l === 0);
    join.disabled = !open || l === 0;
    join.textContent = !open ? '報名已截止' : l === 0 ? '已額滿' : '我要報名';
    $('#adm-note').textContent = !open ? '報名表單已關閉' : l === 0 ? '名額已滿' : '共 ' + regs.length + ' 筆報名';
  }
  function renderRegs(){
    const tb = $('#adm-rows'); tb.innerHTML = '';
    if (!regs.length){ tb.innerHTML = '<tr><td colspan="5" class="empty">還沒有人報名</td></tr>'; }
    regs.forEach((r, i) => {
      const tr = document.createElement('tr');
      [r.n, mask(r.p), r.c, r.at].forEach(v => { const td = document.createElement('td'); td.textContent = v; tr.append(td); });
      const td = document.createElement('td'), x = document.createElement('button');
      x.type = 'button'; x.className = 'del'; x.textContent = '×'; x.setAttribute('aria-label', '刪除 ' + r.n + ' 的報名');
      x.onclick = () => { regs.splice(i, 1); newIdx = -1; renderRegs(); };
      td.append(x); tr.append(td);
      if (i === newIdx){ tr.classList.add('new'); setTimeout(() => tr.classList.remove('new'), 1600); }
      tb.append(tr);
    });
    updateStats();
  }

  /* ---- 分頁：活動報名頁／後台管理 ---- */
  const tabs = { page: $('#tab-page'), admin: $('#tab-admin') };
  function show(which){
    for (const k in tabs){
      const on = k === which;
      tabs[k].classList.toggle('on', on); tabs[k].setAttribute('aria-selected', on);
      $('#view-' + k).hidden = !on;
    }
  }
  tabs.page.onclick = () => show('page');
  tabs.admin.onclick = () => show('admin');
  $('#adm-open').onchange = e => { open = e.target.checked; updateStats(); };
  $('#adm-export').onclick = () => {
    const rows = [['姓名','手機','人數','報名時間']].concat(regs.map(r => [r.n, r.p, r.c, r.at]));
    const csv = '\ufeff' + rows.map(r => r.map(v => '"' + String(v).replace(/"/g,'""') + '"').join(',')).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type:'text/csv;charset=utf-8' }));
    a.download = (data.title || '活動') + '_報名名單.csv'; a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  };

  /* ---- 報名彈窗 ---- */
  const dlg = $('#reg'), form = $('#reg-form'), done = $('#reg-done'), msg = $('#reg-msg');
  function openReg(){
    form.reset(); msg.textContent = ''; form.hidden = false; done.hidden = true;
    const sel = form.elements.c, l = left();
    [...sel.options].forEach(o => { o.disabled = +o.value > l; });
    if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open','');
    form.elements.n.focus();
  }
  const closeReg = () => { if (dlg.open) dlg.close(); };
  join.onclick = openReg;
  $('#reg-x').onclick = closeReg;
  $('#reg-close').onclick = () => { closeReg(); join.focus(); };
  dlg.addEventListener('click', e => { if (e.target === dlg) closeReg(); });
  form.elements.p.addEventListener('input', e => { e.target.value = e.target.value.replace(/[^0-9]/g,''); });
  form.addEventListener('submit', e => {
    e.preventDefault();
    const n = form.elements.n.value.trim(), p = form.elements.p.value.trim(), c = +form.elements.c.value;
    if (!n){ msg.textContent = '請填寫姓名。'; form.elements.n.focus(); return; }
    if (!/^09\d{8}$/.test(p)){ msg.textContent = '手機號碼請填 09 開頭的 10 碼數字。'; form.elements.p.focus(); return; }
    if (c > left()){ msg.textContent = '剩餘名額不足，請減少人數。'; return; }
    const d = new Date(), z = x => String(x).padStart(2,'0');
    regs.push({ n, p, c, at: z(d.getMonth()+1)+'/'+z(d.getDate())+' '+z(d.getHours())+':'+z(d.getMinutes()) });
    newIdx = regs.length - 1; renderRegs();
    $('#reg-done-txt').textContent = n + '，您已報名「' + (data.title || '活動') + '」' + c + ' 人。主辦方的後台現在就看得到這筆資料。';
    form.hidden = true; done.hidden = false; $('#reg-to-admin').focus();
  });
  $('#reg-to-admin').onclick = () => { closeReg(); show('admin'); tabs.admin.focus(); };

  /* ---- 資料表輸入 ---- */
  document.querySelectorAll('.sheet [data-k]').forEach(inp => {
    render(inp.dataset.k, inp.value, false);
    inp.addEventListener('input', () => {
      if (inp.dataset.k === 'seats') inp.value = inp.value.replace(/[^0-9]/g,'');
      render(inp.dataset.k, inp.value, true);
    });
  });
  renderRegs();

  /* ---- 活動流程：可新增、刪除 ---- */
  const MAX = 8, rows = $('#flow-rows'), out = $('#ev-flow'), wrap = $('#ev-flow-wrap'), add = $('#add-flow');
  function renderFlow(fl){
    const items = [...rows.querySelectorAll('tr')].map(tr => [tr.querySelector('.ti').value.trim(), tr.querySelector('.it').value.trim()]).filter(([a,b]) => a || b);
    out.innerHTML = '';
    items.forEach(([time, item]) => {
      const li = document.createElement('li'), s1 = document.createElement('span'), s2 = document.createElement('span');
      s1.textContent = time || '—'; s2.textContent = item || '（未填）'; li.append(s1, s2); out.append(li);
    });
    wrap.hidden = !items.length;
    add.disabled = rows.children.length >= MAX;
    if (fl) flash(out);
  }
  function addRow(time = '', item = '', focus = false){
    if (rows.children.length >= MAX) return;
    const tr = document.createElement('tr');
    tr.innerHTML = '<td class="t"><input class="ti" placeholder="時間" maxlength="8" aria-label="時間"></td><td><input class="it" placeholder="流程內容" maxlength="20" aria-label="流程內容"></td><td class="x"><button type="button" class="del" aria-label="刪除這一列">×</button></td>';
    tr.querySelector('.ti').value = time; tr.querySelector('.it').value = item;
    tr.querySelectorAll('input').forEach(i => i.addEventListener('input', () => renderFlow(true)));
    tr.querySelector('.del').addEventListener('click', () => { tr.remove(); renderFlow(true); add.focus(); });
    rows.append(tr);
    if (focus) tr.querySelector('.ti').focus();
  }
  [['09:30','報到、領取餐具'],['10:00','龍眼樹下食材導覽'],['11:30','樹下共餐']].forEach(([a,b]) => addRow(a,b));
  add.addEventListener('click', () => { addRow('', '', true); renderFlow(true); });
  renderFlow(false);
})();

/* ========== 照片作品：讀取攝影網站同一張 Google 試算表 ========== */
/* TODO：新帳號的「網站內容」試算表發布後，把 Content 分頁的 CSV 網址貼在這裡 */
const SHEET_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vR4eAVOw4fa7Llxa3svrpJKL1IEQfPc4Tj5K3IzYsl5rJ9IZBWNxJmFcDI0aQR3NYzXPCAfAk0sUlyl/pub?gid=564649891&single=true&output=csv';
let projectsData = [];
function driveUrl(url){ if (!url) return ''; const m = url.includes('drive.google.com') && url.match(/\/d\/([a-zA-Z0-9_-]+)/); return m ? 'https://lh3.googleusercontent.com/d/'+m[1] : safeUrl(url); }
function loadSheet(){
  const grid = $('#project-grid');
  const fail = () => { grid.innerHTML = '<p class="grid-note">作品暫時無法載入，請稍後重新整理。</p>'; };
  if (!window.Papa) return fail();
  Papa.parse(SHEET_URL, { download:true, header:true, error: fail, complete: res => {
    const services = []; projectsData = [];
    res.data.forEach(row => { if (!row.title) return; const type = (row.type||'story').toLowerCase().trim(), cover = driveUrl(row.cover);
      if (type==='service') services.push({ title:row.title, subtitle:row.subtitle||row.category||'', cover, description:row.description||'', price:row.price||'', details:row.details ? row.details.split(',').map(x=>x.trim()) : [] });
      else if (type==='hero'){ if (cover) document.querySelector('.hero').style.backgroundImage = 'linear-gradient(rgba(250,248,243,.93),rgba(250,248,243,.97)),url("'+cover.replace(/["\\\n]/g,'')+'")'; }
      else if (type!=='about') projectsData.push({ title:row.title, category:row.category||row.subtitle||'', cover, description:row.description||'',
        images: row.images ? row.images.split(',').map(it => { const p = it.split('|'); return { url:driveUrl((p[0]||'').trim()), caption:(p[1]||'').trim() }; }).filter(im => im.url) : [] }); });
    if (!projectsData.length) return fail();
    /* 主視覺右側：取前三組活動紀錄的封面 */
    const shots = projectsData.slice(0,3).filter(p => p.cover);
    if (shots.length){
      $('#shots').innerHTML = shots.map((p,i)=>`<button type="button" class="shot" onclick="openProject(${i})" aria-label="看「${esc(p.title)}」照片"><img src="${esc(p.cover)}" alt="" loading="${i?'lazy':'eager'}"><span>${esc(p.title)}</span></button>`).join('');
      $('#shots').dataset.n = shots.length;
      $('#hero-shots').hidden = false; $('#hero-grid').classList.remove('hero-solo');
    }
    grid.innerHTML = projectsData.map((p,i)=>`<button type="button" class="card photo-card" onclick="openProject(${i})"><div class="card-image-wrapper">${p.cover ? `<img src="${esc(p.cover)}" alt="${esc(p.title)}" loading="lazy">` : `<span class="no-cover">照片整理中</span>`}</div><div class="card-info"><span class="card-meta">${esc(p.category)}</span><h3 class="card-title">${esc(p.title)}</h3><p class="card-desc">${esc(p.description)}</p></div></button>`).join('');
    if (services.length){
      /* 攝影方案：精簡卡片，不放照片 */
      const priceParts = s => { const m = String(s||'').match(/NT\$\s*([\d,]+)\s*(?:\/|／)?\s*(.*)$/); return m ? { n: m[1], unit: m[2] ? '／' + m[2].trim() : '' } : null; };
      $('#photo-services').innerHTML = services.map(sv => {
        const pp = priceParts(sv.price);
        const price = pp ? `<b class="price-main">NT$${esc(pp.n)}<small>${esc(pp.unit)}</small></b>` : `<b class="price-main">${esc(sv.price)}</b>`;
        return `<article class="card plan-card"><span class="service-subtitle">${esc(sv.subtitle)}</span><h3 class="plan-title">${esc(sv.title)}</h3><p class="plan-desc">${esc(sv.description)}</p>${sv.details.map(d=>{ const p = d.split(/[:：]/); return `<div class="detail-item"><span>${esc(p[0].trim())}</span><span>${esc((p.slice(1).join('：')||'').trim())}</span></div>`; }).join('')}<div class="price">${price}</div><a href="#contact" class="btn-lively" onclick="selectService('活動攝影')">預約諮詢</a></article>`;
      }).join('');
      $('#photo-svc-wrap').hidden = false;
      /* 上方的攝影卡改成摘要，連到下方方案 */
      const st = $('#static-photo');
      if (st){
        const nums = services.map(sv => priceParts(sv.price)).filter(Boolean).map(p => +p.n.replace(/,/g,''));
        if (nums.length){ const min = Math.min(...nums); const pm = $('.price-main', st); if (pm) pm.innerHTML = 'NT$' + min.toLocaleString('en-US') + '<small>起／場</small>'; }
        const lbl = $('.price-label', st); if (lbl) lbl.textContent = '共 ' + services.length + ' 種攝影方案';
        const go = $('.btn-lively', st); if (go){ go.textContent = '看攝影方案'; go.setAttribute('href', '#photo-svc-wrap'); go.removeAttribute('onclick'); }
      }
    }
  }});
}
const modal = $('#project-modal');
function openProject(i){ const d = projectsData[i]; $('#m-category').textContent = d.category; $('#m-title').textContent = d.title; $('#m-desc').textContent = d.description;
  $('#m-gallery').innerHTML = d.images.length ? d.images.map(im => `<figure class="modal-figure"><img src="${esc(im.url)}" alt="${esc(d.title)}" loading="lazy">${im.caption?`<figcaption class="modal-caption">${esc(im.caption)}</figcaption>`:''}</figure>`).join('') : '<p class="grid-note">無更多照片</p>';
  modal.classList.add('active'); document.body.style.overflow = 'hidden'; modal.scrollTop = 0; $('.modal-close').focus(); }
function closeModal(){ modal.classList.remove('active'); document.body.style.overflow = ''; }
modal.addEventListener('click', e => { if (e.target===modal) closeModal(); });
document.addEventListener('keydown', e => { if (e.key==='Escape' && modal.classList.contains('active')) closeModal(); });
document.addEventListener('contextmenu', e => { if (e.target.tagName==='IMG') e.preventDefault(); });
loadSheet();
(function(){ const a = $('#mail-link'); if (a){ a.href = 'mailto:' + MAIL; a.textContent = MAIL; } })();
/* ========== 導覽：平滑捲動到區塊、目前位置標示、回到頂端 ========== */
(function(){
  const nav = $('.nav-links'), toggle = $('.menu-toggle'), header = $('header');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const setMenu = open => { nav.classList.toggle('open', open); toggle.setAttribute('aria-expanded', open); toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單'); };
  toggle.onclick = () => setMenu(!nav.classList.contains('open'));

  function go(id){
    const el = document.getElementById(id); if (!el) return;
    const top = el.getBoundingClientRect().top + window.scrollY - header.offsetHeight + 1;
    window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
    history.replaceState(null, '', '#' + id);
  }
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    const id = a.getAttribute('href').slice(1); if (!id) return;
    a.addEventListener('click', e => {
      if (!document.getElementById(id)) return;
      e.preventDefault(); setMenu(false); go(id);
    });
  });

  const links = [...nav.querySelectorAll('a')];
  const sections = links.map(a => document.getElementById(a.getAttribute('href').slice(1))).filter(Boolean);
  const topBtn = $('#to-top');
  function spy(){
    const y = window.scrollY + header.offsetHeight + window.innerHeight * 0.25;
    let cur = null;
    sections.forEach(s => { if (s.offsetTop <= y) cur = s.id; });
    if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) cur = 'contact';
    links.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + cur));
    topBtn.classList.toggle('show', window.scrollY > 700);
  }
  let ticking = false;
  window.addEventListener('scroll', () => { if (!ticking){ ticking = true; requestAnimationFrame(() => { spy(); ticking = false; }); } }, { passive:true });
  topBtn.onclick = () => { window.scrollTo({ top:0, behavior: reduce ? 'auto' : 'smooth' }); history.replaceState(null, '', location.pathname + location.search); };
  spy();
  if (location.hash && document.getElementById(location.hash.slice(1))) setTimeout(() => go(location.hash.slice(1)), 300);
})();
